{
  "name": "@gardener/shared",
  "version": "1.0.0",
  "description": "Techer 共享类型、常量、校验器、端点契约、跨端工具 — Web 端、小程序端、后端服务的单一事实来源",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./constants": {
      "import": "./dist/constants/index.js",
      "types": "./dist/constants/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./validators": {
      "import": "./dist/validators/index.js",
      "types": "./dist/validators/index.d.ts"
    },
    "./api": {
      "import": "./dist/api/index.js",
      "types": "./dist/api/index.d.ts"
    },
    "./api/endpoints": {
      "import": "./dist/api/endpoints.js",
      "types": "./dist/api/endpoints.d.ts"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "types": "./dist/utils/index.d.ts"
    },
    "./utils/sse-parser": {
      "import": "./dist/utils/sse-parser.js",
      "types": "./dist/utils/sse-parser.d.ts"
    },
    "./utils/game-helpers": {
      "import": "./dist/utils/game-helpers.js",
      "types": "./dist/utils/game-helpers.d.ts"
    },
    "./utils/general": {
      "import": "./dist/utils/general.js",
      "types": "./dist/utils/general.d.ts"
    },
    "./utils/export-data": {
      "import": "./dist/utils/export-data.js",
      "types": "./dist/utils/export-data.d.ts"
    },
    "./utils/image-spec": {
      "import": "./dist/utils/image-spec.js",
      "types": "./dist/utils/image-spec.d.ts"
    },
    "./utils/game-mappings": {
      "import": "./dist/utils/game-mappings.js",
      "types": "./dist/utils/game-mappings.d.ts"
    },
    "./utils/security": {
      "import": "./dist/utils/security.js",
      "types": "./dist/utils/security.d.ts"
    },
    "./auth": {
      "import": "./dist/auth/index.js",
      "types": "./dist/auth/index.d.ts"
    },
    "./auth/machine": {
      "import": "./dist/auth/machine.js",
      "types": "./dist/auth/machine.d.ts"
    },
    "./auth/factory": {
      "import": "./dist/auth/factory.js",
      "types": "./dist/auth/factory.d.ts"
    },
    "./schemas": {
      "import": "./dist/schemas/index.js",
      "types": "./dist/schemas/index.d.ts"
    },
    "./schemas/crud-schema": {
      "import": "./dist/schemas/crud-schema.js",
      "types": "./dist/schemas/crud-schema.d.ts"
    },
    "./schemas/subject-schema": {
      "import": "./dist/schemas/subject-schema.js",
      "types": "./dist/schemas/subject-schema.d.ts"
    },
    "./schemas/quicktool-schema": {
      "import": "./dist/schemas/quicktool-schema.js",
      "types": "./dist/schemas/quicktool-schema.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "techer",
    "shared",
    "types",
    "constants",
    "validators",
    "api",
    "utils"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
