{
  "$schema": "https://framework-10081391.cos.ap-shanghai.myqcloud.com/schema/cloudbaserc.json",
  "envId": "prod-d6g1zoq8c7be4ce53",
  "functionRoot": "dist",
  "cloudRun": {
    "services": [
      {
        "name": "tec-work",
        "image": "ccr.ccs.tencentyun.com/<请替换为你的TCR命名空间>/tec-work:latest",
        "cpu": 1,
        "mem": 2,
        "minNum": 0,
        "maxNum": 5,
        "port": 3000,
        "containerPort": 3000,
        "remark": "园丁工作台后端：微信授权登录 + 教师多租户 + 集中配置 + AI 代理",
        "envVariables": {
          "PORT": "3000",
          "NODE_ENV": "production",
          "DB_HOST": "<腾讯云数据库 MySQL 内网地址>",
          "DB_PORT": "3306",
          "DB_USERNAME": "<数据库用户名>",
          "DB_PASSWORD": "<数据库密码>",
          "DB_DATABASE": "gardener",
          "DB_SSL": "false",
          "DB_SYNCHRONIZE": "false",
          "JWT_SECRET": "<至少 32 位随机字符串>",
          "ENCRYPTION_KEY": "<至少 32 位随机字符串>",
          "CORS_ORIGIN": "<Web 管理端域名>",
          "SUPER_ADMIN_USER": "admin",
          "SUPER_ADMIN_PASSWORD": "<bcrypt 哈希密码>",
          "WECHAT_APPID": "wx1e6d151c7eb428cc",
          "WECHAT_SECRET": "<微信小程序 AppSecret>",
          "DEFAULT_SUBJECTS": "语文,数学,英语,科学,物理,化学,生物,历史,地理,政治,音乐,美术,体育,信息技术,综合实践",
          "LOGIN_CODE": "1314520",
          "AI_BASE_URL": "https://dashscope.aliyuncs.com/compatible-mode/v1",
          "AI_API_KEY": "<阿里云 DashScope API Key>",
          "AI_TEXT_MODEL": "qwen-plus",
          "AI_VISION_MODEL": "qwen-vl-plus",
          "AI_TEMPERATURE": "0.7",
          "AI_NAME": "小林子",
          "AI_SYSTEM_PROMPT": "你是一位耐心、专业的中国中小学班主任助手。"
        }
      }
    ]
  }
}
