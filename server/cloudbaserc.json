{
  "$schema": "https://framework-10081391.cos.ap-shanghai.myqcloud.com/schema/cloudbaserc.json",
  "envId": "prod-d6g1zoq8c7be4ce53",
  "functionRoot": "dist",
  "cloudRun": {
    "services": [
      {
        "name": "tec-work",
        "image": "ccr.ccs.tencentyun.com/your-namespace/tec-work:latest",
        "cpu": 1,
        "mem": 2,
        "minNum": 0,
        "maxNum": 5,
        "port": 3000,
        "containerPort": 3000,
        "remark": "园丁工作台后端：微信授权登录 + 教师多租户 + 集中配置 + AI 代理",
        "envVariables": {
          "PORT": "3000",
          "DB_HOST": "REPLACE_WITH_TENCENTDB_HOST.rds.tencent.com",
          "DB_PORT": "3306",
          "DB_USERNAME": "REPLACE_WITH_DB_USER",
          "DB_PASSWORD": "REPLACE_WITH_DB_PASSWORD",
          "DB_DATABASE": "REPLACE_WITH_DB_NAME",
          "DB_SSL": "false",
          "DB_SYNCHRONIZE": "false",
          "JWT_SECRET": "REPLACE_WITH_A_LONG_RANDOM_SECRET",
          "WECHAT_APPID": "REPLACE_WITH_WECHAT_APPID",
          "WECHAT_SECRET": "REPLACE_WITH_WECHAT_SECRET",
          "DEFAULT_SUBJECTS": "语文,数学,英语,科学,物理,化学,生物,历史,地理,政治,音乐,美术,体育,信息技术,综合实践",
          "LOGIN_CODE": "1314520",
          "AI_BASE_URL": "https://dashscope.aliyuncs.com/compatible-mode/v1",
          "AI_API_KEY": "REPLACE_WITH_AI_KEY_OR_LEAVE_EMPTY",
          "AI_TEXT_MODEL": "qwen-plus",
          "AI_VISION_MODEL": "qwen-vl-plus",
          "AI_TEMPERATURE": "0.7",
          "AI_NAME": "小林子",
          "AI_SYSTEM_PROMPT": "你是一位耐心、专业的中国中小学班主任助手。"
        }
      }
    ]
  }
}
