{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    // P2-16：渐进式启用严格模式（先开 strictNullChecks + noImplicitAny + forceConsistentCasingInFileNames，
    // 观察 CI 通过后再升 strict: true。全量 strict 需修复约 200+ 隐式 any 与 null 未检查错误。）
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "paths": {
      "@gardener/shared": ["node_modules/@gardener/shared/dist", "../shared/dist", "vendor/gardener-shared/dist"],
      "@gardener/shared/*": ["node_modules/@gardener/shared/dist/*", "../shared/dist/*", "vendor/gardener-shared/dist/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
